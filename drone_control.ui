QWidget {
    background-color: #f5f5f5;
    font-family: "Roboto", "Arial";
    font-size: 11px;
    color: #333333;
}
QGroupBox {
    font-weight: bold;
    font-size: 12px;
    margin-top: 10px;
    padding: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
}
QPushButton {
    color: white;
    font-weight: bold;
    border-radius: 3px;
    padding: 6px 12px;
}
QPushButton#btnConnect {
    background-color: #4CAF50;
    min-width: 120px;
    min-height: 35px;
}
QPushButton#btnConnect:hover { background-color: #45a049; }
QPushButton#btnConnect:pressed { background-color: #3d8b40; }
QPushButton#btnArm { background-color: #FF9800; min-width: 150px; min-height: 40px; }
QPushButton#btnArm:hover { background-color: #FB8C00; }
QPushButton#btnArm:pressed { background-color: #F57C00; }
QPushButton#btnTakeoff { background-color: #2196F3; min-width: 150px; min-height: 40px; }
QPushButton#btnTakeoff:hover { background-color: #1976D2; }
QPushButton#btnTakeoff:pressed { background-color: #1565C0; }
QPushButton#btnLand { background-color: #F44336; min-width: 150px; min-height: 40px; }
QPushButton#btnLand:hover { background-color: #DA190B; }
QPushButton#btnLand:pressed { background-color: #B71C1C; }
QPushButton#btnRTH { background-color: #9C27B0; min-width: 150px; min-height: 40px; }
QPushButton#btnRTH:hover { background-color: #7B1FA2; }
QPushButton#btnRTH:pressed { background-color: #6A1B9A; }
QPushButton#btnGoToTarget { background-color: #009688; min-width: 160px; min-height: 36px; }
QPushButton#btnGoToTarget:hover { background-color: #00897B; }
QPushButton#btnGoToTarget:pressed { background-color: #00796B; }
QPushButton#btnClearHistory { background-color: #607D8B; min-width: 120px; min-height: 30px; }
QPushButton#btnClearHistory:hover { background-color: #546E7A; }
QPushButton#btnClearHistory:pressed { background-color: #455A64; }
QPushButton:disabled { opacity: 0.5; }
QSlider::groove:horizontal {
    height: 8px;
    border: 1px solid #999999;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    width: 16px;
    margin: -6px 0;
    border-radius: 8px;
    background: #FF9800;
}
QSlider#sliderThrottle::handle:horizontal { background: #4CAF50; }
QSlider::handle:horizontal:hover { width: 18px; height: 18px; }
QLabel.value {
    font-weight: bold;
    color: #2196F3;
}
QLabel.status-disconnected { color: #F44336; font-weight: bold; }
QLabel.status-connected { color: #4CAF50; font-weight: bold; }
QLabel.status-warning { color: #FF9800; font-weight: bold; }
